   "options": "<div style=\"border: 1px solid #f5c2c7; background-color: #fff1f2; padding: 16px; border-radius: 6px;\">\n  <h4 style=\"color: #842029; margin-top: 0;\">\n    \ud83d\udccc Declaration\n  </h4>\n\n  <p style=\"color: #842029; margin-bottom: 0;\">\n    I hereby declare that the information provided in this form is true and accurate to the best of my knowledge. \n    I understand that any misrepresentation or provision of false information may result in termination of employment \n    and may lead to subsequent legal action.\n  </p>\n</div>\n"
