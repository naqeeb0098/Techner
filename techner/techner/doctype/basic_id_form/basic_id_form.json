  {
   "fieldname": "documents_list",
   "fieldtype": "HTML",
   "label": "Documents List",
   "options": "<div style=\"border: 1px solid #d1e7dd; background-color: #f0fff7; padding: 15px; border-radius: 6px;\">\n  <h4 style=\"color: #0f5132; margin-top: 0;\">\n    \ud83d\udcc4 Required Documents\n  </h4>\n\n  <p style=\"color: #0f5132; margin-bottom: 10px;\">\n    Please provide <strong>properly coloured scanned copies</strong> of the following documents:\n  </p>\n\n  <ul style=\"color: #0f5132; padding-left: 20px;\">\n    <li><strong>National Identity Card (CNIC / ID)</strong> \u2013 Both sides or equivalent</li>\n    <li><strong>Passport</strong> \u2013 Please include both pages <em>(Optional)</em></li>\n    <li>\n      <strong>Any one Utility Bill</strong> for proof of address  \n      <br>\n      <small>(Electricity, Gas, Landline, Broadband, etc.)</small>\n    </li>\n    <li>\n      <strong>6-month Bank Statement</strong> showing full name, address, and salary/income\n    </li>\n  </ul>\n</div>\n"
  },
  {
   "fieldname": "important_section",
   "fieldtype": "Section Break",
   "label": "IMPORTANT"
  },
  {
   "fieldname": "important",
   "fieldtype": "HTML",
   "label": "Important",
   "options": "<div style=\"border: 1px solid #f5c2c7; background-color: #fff1f2; padding: 16px; border-radius: 6px;\">\n  <h4 style=\"color: #842029; margin-top: 0;\">\n    \u26a0 Important Security &amp; Conduct Guidelines\n  </h4>\n\n  <ol style=\"color: #842029; padding-left: 20px;\">\n    <li style=\"margin-bottom: 10px;\">\n      <strong>Protocol for Confidential Requests</strong><br>\n      Management will never request sensitive information via email. Any such communication should be reported immediately. \n      Project data, personal details, or financial matters will only be discussed following a formal verbal confirmation.\n    </li>\n\n    <li style=\"margin-bottom: 10px;\">\n      <strong>Bank Details Update</strong><br>\n      Requests to update bank account details will not be processed over email. Such changes will only be considered after a \n      formal video call with the concerned staff, ensuring proper identity verification and confirmation.\n    </li>\n\n    <li>\n      <strong>Client Interaction</strong><br>\n      All staff are expected to maintain a professional environment by avoiding political, religious, or other sensitive discussions \n      in the workplace or with clients. Personal beliefs should remain separate to ensure a respectful and positive professional setting.\n    </li>\n  </ol>\n</div>\n"
  },
