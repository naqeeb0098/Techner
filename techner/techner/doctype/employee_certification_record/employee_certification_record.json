   "options": "<div style='width:90%; margin:15px 0; font-family:\"Segoe UI\", Arial, sans-serif;'>\n\n    <!-- Title -->\n    <div style=\"background:#2563eb; color:#ffffff; padding:12px 16px; border-radius:6px 6px 0 0;\">\n        <h2 style=\"margin:0; font-size:20px; font-weight:600;\">\n            Techner - Employee Certification Record\n        </h2>\n    </div>\n\n    <!-- Content -->\n    <div style=\"border:1px solid #d1d5db; border-top:none; padding:16px; background:#f8fafc; border-radius:0 0 6px 6px;\">\n\n        <p style=\"font-size:14px; line-height:1.6; color:#374151; margin-top:0;\">\n            Please provide the details of the certifications you have completed in the past few months \n            from the list below. Your prompt response will help us maintain an accurate record of \n            training and professional development.\n        </p>\n\n        <!-- Important Note -->\n        <div style=\"margin-top:12px; padding:10px 12px; background:#fff7ed; border-left:4px solid #f97316; border-radius:4px; font-size:13px; color:#374151;\">\n            <strong>Note:</strong> Kindly add the <b>completion date</b> for all certifications you have completed, \n            as it is mandatory for record keeping.\n        </div>\n\n    </div>\n\n</div>"
