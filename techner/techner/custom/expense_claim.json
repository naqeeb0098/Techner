   "name": "Expense Claim-custom_edit_notification",
   "no_copy": 0,
   "non_negative": 0,
   "options": "<div style=\"width: 100%;\n    display: flex;\n    align-items: center;\n    padding: 9px 12px;\n    margin: 5px 0;\n    box-sizing: border-box;\n    background-color: #fff8db;\n    border: 1px solid #f0d98a;\n    border-left: 4px solid #f0ad4e;\n    border-radius: 5px;\n    color: #6b5200;\n    font-size: 13px;\n    text-align: left;\">\n\n    <!-- ERPNext Standard Edit Icon -->\n    <span style=\"display: flex;\n        align-items: center;\n        justify-content: center;\n        flex-shrink: 0;\n        width: 28px;\n        height: 28px;\n        background-color: #ffffff;\n        border: 1px solid #efd88d;\n        border-radius: 5px;\n        color: #d79500;\">\n        <svg class=\"icon icon-sm\">\n            <use href=\"#icon-edit\"></use>\n        </svg>\n    </span>\n\n    <!-- Notification Text -->\n    <span style=\"flex: 1; line-height: 1.5;\">\n        To view the details, please click the\n        <strong style=\"color: #946800;\">Edit</strong> button.\n    </span>\n\n    <!-- Up Arrow -->\n    <span style=\"display: flex;\n        align-items: center;\n        justify-content: center;\n        flex-shrink: 0;\n        width: 28px;\n        height: 28px;\n        background-color: #e9a800;\n        color: #ffffff;\n        border-radius: 50%;\n        font-size: 19px;\n        font-weight: bold;\n        line-height: 1;\">\n        \u2191\n    </span>\n\n</div>",
