   "name": "Expense Claim-custom_guidelines",
   "no_copy": 0,
   "non_negative": 0,
   "options": "<style>\n    .expense-guidelines-full-width {\n        position: relative !important;\n        left: -20px !important;\n        display: block !important;\n        width: calc(100% + 40px) !important;\n        max-width: none !important;\n        margin: 0 !important;\n        padding: 0 !important;\n        box-sizing: border-box !important;\n        font-family: Arial, Helvetica, sans-serif;\n        text-align: left !important;\n    }\n\n    .expense-guidelines-full-width * {\n        box-sizing: border-box !important;\n    }\n\n    .expense-columns {\n        width: 100% !important;\n        table-layout: fixed !important;\n        border-collapse: separate !important;\n        border-spacing: 7px 5px !important;\n    }\n\n    .expense-column {\n        width: 50% !important;\n        vertical-align: top !important;\n    }\n\n    .expense-item {\n        width: 100% !important;\n        height: 44px;\n        border-collapse: collapse !important;\n        background-color: #f7f9fc;\n        border-left: 3px solid #245985;\n    }\n\n    .expense-item-warning {\n        background-color: #fff9e8;\n        border-left-color: #f4a62a;\n    }\n\n    @media screen and (max-width: 767px) {\n        .expense-guidelines-full-width {\n            left: -10px !important;\n            width: calc(100% + 20px) !important;\n        }\n\n        .expense-columns,\n        .expense-columns > tbody,\n        .expense-columns > tbody > tr,\n        .expense-column {\n            display: block !important;\n            width: 100% !important;\n        }\n\n        .expense-columns {\n            border-spacing: 0 !important;\n        }\n\n        .expense-column {\n            padding: 0 0 5px !important;\n        }\n    }\n</style>\n\n<div class=\"expense-guidelines-full-width\">\n\n    <!-- Heading -->\n    <div style=\"\n        width:100%;\n        margin:0;\n        padding:8px 14px;\n        background-color:#245985;\n        color:#ffffff;\n        text-align:left !important;\n    \">\n        <div style=\"\n            margin:0;\n            padding:0;\n            color:#ffffff;\n            font-size:16px;\n            line-height:20px;\n            font-weight:700;\n            text-align:left !important;\n        \">\n            Expense Claim Guidelines\n        </div>\n\n        <div style=\"\n            margin:1px 0 0;\n            padding:0;\n            color:#e6f0f8;\n            font-size:10px;\n            line-height:14px;\n            text-align:left !important;\n        \">\n            Important instructions for submitting expense claims\n        </div>\n    </div>\n\n    <!-- Body -->\n    <div style=\"\n        width:100%;\n        margin:0;\n        padding:8px 10px 10px;\n        background-color:#ffffff;\n        border:1px solid #dfe3e8;\n        border-top:0;\n        text-align:left !important;\n    \">\n\n        <div style=\"\n            margin:0 7px 3px;\n            padding:0;\n            color:#31465a;\n            font-size:11px;\n            line-height:16px;\n            text-align:left !important;\n        \">\n            Please review the following guidelines before submitting an expense claim.\n        </div>\n\n        <table\n            class=\"expense-columns\"\n            role=\"presentation\"\n            cellpadding=\"0\"\n            cellspacing=\"0\"\n            border=\"0\"\n        >\n            <tr>\n\n                <!-- Left column: 1 to 4 -->\n                <td class=\"expense-column\" style=\"padding:0 3px 0 0;\">\n\n                    <!-- 1 -->\n                    <table class=\"expense-item\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                        <tr>\n                            <td style=\"width:32px; padding:7px 2px 7px 7px; vertical-align:middle;\">\n                                <span style=\"\n                                    display:inline-block;\n                                    width:18px;\n                                    height:18px;\n                                    line-height:18px;\n                                    border-radius:50%;\n                                    background-color:#245985;\n                                    color:#ffffff;\n                                    font-size:10px;\n                                    font-weight:bold;\n                                    text-align:center;\n                                \">1</span>\n                            </td>\n\n                            <td style=\"\n                                padding:7px 8px 7px 2px;\n                                vertical-align:middle;\n                                color:#253858;\n                                font-size:10.5px;\n                                line-height:15px;\n                                text-align:left !important;\n                            \">\n                                Please ensure all expenses are\n                                <strong>work-related</strong> and clearly described.\n                            </td>\n                        </tr>\n                    </table>\n\n                    <!-- 2 -->\n                    <table class=\"expense-item\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                           style=\"margin-top:5px;\">\n                        <tr>\n                            <td style=\"width:32px; padding:7px 2px 7px 7px; vertical-align:middle;\">\n                                <span style=\"\n                                    display:inline-block;\n                                    width:18px;\n                                    height:18px;\n                                    line-height:18px;\n                                    border-radius:50%;\n                                    background-color:#245985;\n                                    color:#ffffff;\n                                    font-size:10px;\n                                    font-weight:bold;\n                                    text-align:center;\n                                \">2</span>\n                            </td>\n\n                            <td style=\"\n                                padding:7px 8px 7px 2px;\n                                vertical-align:middle;\n                                color:#253858;\n                                font-size:10.5px;\n                                line-height:15px;\n                                text-align:left !important;\n                            \">\n                                Receipts or supporting documents must be attached for all claims.\n                            </td>\n                        </tr>\n                    </table>\n\n                    <!-- 3 -->\n                    <table class=\"expense-item\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                           style=\"margin-top:5px;\">\n                        <tr>\n                            <td style=\"width:32px; padding:7px 2px 7px 7px; vertical-align:middle;\">\n                                <span style=\"\n                                    display:inline-block;\n                                    width:18px;\n                                    height:18px;\n                                    line-height:18px;\n                                    border-radius:50%;\n                                    background-color:#245985;\n                                    color:#ffffff;\n                                    font-size:10px;\n                                    font-weight:bold;\n                                    text-align:center;\n                                \">3</span>\n                            </td>\n\n                            <td style=\"\n                                padding:7px 8px 7px 2px;\n                                vertical-align:middle;\n                                color:#253858;\n                                font-size:10.5px;\n                                line-height:15px;\n                                text-align:left !important;\n                            \">\n                                Prior approval is required before incurring any expense\n                                to ensure smooth and timely processing.\n                            </td>\n                        </tr>\n                    </table>\n\n                    <!-- 4 -->\n                    <table class=\"expense-item\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                           style=\"margin-top:5px;\">\n                        <tr>\n                            <td style=\"width:32px; padding:7px 2px 7px 7px; vertical-align:middle;\">\n                                <span style=\"\n                                    display:inline-block;\n                                    width:18px;\n                                    height:18px;\n                                    line-height:18px;\n                                    border-radius:50%;\n                                    background-color:#245985;\n                                    color:#ffffff;\n                                    font-size:10px;\n                                    font-weight:bold;\n                                    text-align:center;\n                                \">4</span>\n                            </td>\n\n                            <td style=\"\n                                padding:7px 8px 7px 2px;\n                                vertical-align:middle;\n                                color:#253858;\n                                font-size:10.5px;\n                                line-height:15px;\n                                text-align:left !important;\n                            \">\n                                Ensure that an estimated amount is discussed and agreed\n                                at the time of approval.\n                            </td>\n                        </tr>\n                    </table>\n\n                </td>\n\n                <!-- Right column: 5 to 7 -->\n                <td class=\"expense-column\" style=\"padding:0 0 0 3px;\">\n\n                    <!-- 5 -->\n                    <table class=\"expense-item\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                        <tr>\n                            <td style=\"width:32px; padding:7px 2px 7px 7px; vertical-align:middle;\">\n                                <span style=\"\n                                    display:inline-block;\n                                    width:18px;\n                                    height:18px;\n                                    line-height:18px;\n                                    border-radius:50%;\n                                    background-color:#245985;\n                                    color:#ffffff;\n                                    font-size:10px;\n                                    font-weight:bold;\n                                    text-align:center;\n                                \">5</span>\n                            </td>\n\n                            <td style=\"\n                                padding:7px 8px 7px 2px;\n                                vertical-align:middle;\n                                color:#253858;\n                                font-size:10.5px;\n                                line-height:15px;\n                                text-align:left !important;\n                            \">\n                                Submit expense claims at month end along with the\n                                timesheet to avoid delays.\n                            </td>\n                        </tr>\n                    </table>\n\n                    <!-- 6 -->\n                    <table class=\"expense-item expense-item-warning\"\n                           cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                           style=\"margin-top:5px;\">\n                        <tr>\n                            <td style=\"width:32px; padding:7px 2px 7px 7px; vertical-align:middle;\">\n                                <span style=\"\n                                    display:inline-block;\n                                    width:18px;\n                                    height:18px;\n                                    line-height:18px;\n                                    border-radius:50%;\n                                    background-color:#f4a62a;\n                                    color:#ffffff;\n                                    font-size:10px;\n                                    font-weight:bold;\n                                    text-align:center;\n                                \">6</span>\n                            </td>\n\n                            <td style=\"\n                                padding:7px 8px 7px 2px;\n                                vertical-align:middle;\n                                color:#253858;\n                                font-size:10.5px;\n                                line-height:15px;\n                                text-align:left !important;\n                            \">\n                                Expenses must be claimed in the\n                                <strong>same month</strong> in which the expenditure occurred.\n                            </td>\n                        </tr>\n                    </table>\n\n                    <!-- 7 -->\n                    <table class=\"expense-item\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                           style=\"margin-top:5px;\">\n                        <tr>\n                            <td style=\"width:32px; padding:7px 2px 7px 7px; vertical-align:middle;\">\n                                <span style=\"\n                                    display:inline-block;\n                                    width:18px;\n                                    height:18px;\n                                    line-height:18px;\n                                    border-radius:50%;\n                                    background-color:#245985;\n                                    color:#ffffff;\n                                    font-size:10px;\n                                    font-weight:bold;\n                                    text-align:center;\n                                \">7</span>\n                            </td>\n\n                            <td style=\"\n                                padding:7px 8px 7px 2px;\n                                vertical-align:middle;\n                                color:#253858;\n                                font-size:10.5px;\n                                line-height:15px;\n                                text-align:left !important;\n                            \">\n                                Ensure all details are accurate and complete before submission.\n                            </td>\n                        </tr>\n                    </table>\n\n                </td>\n            </tr>\n        </table>\n\n        <!-- Important note -->\n        <div style=\"\n            width:calc(100% - 14px);\n            margin:3px 7px 0;\n            padding:7px 9px;\n            background-color:#eaf4fb;\n            border:1px solid #acd2ec;\n            color:#174a6e;\n            font-size:10px;\n            line-height:15px;\n            text-align:left !important;\n        \">\n            <strong>Important:</strong>\n            Incomplete claims, missing receipts, or expenses submitted without\n            prior approval may be delayed or returned for correction.\n        </div>\n\n    </div>\n\n    <!-- Footer -->\n    <div style=\"\n        width:100%;\n        margin:0;\n        padding:5px 14px;\n        background-color:#f4f6f8;\n        border:1px solid #dfe3e8;\n        border-top:0;\n        color:#6b778c;\n        font-size:9px;\n        line-height:13px;\n        text-align:left !important;\n    \">\n        This is an automated notification. Please contact the concerned department\n        for further clarification.\n    </div>\n\n</div>",
