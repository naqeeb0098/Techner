   "label": "Preview",
   "length": 0,
   "link_filters": null,
   "mandatory_depends_on": null,
   "modified": "2026-04-07 18:47:36.558344",
   "modified_by": "Administrator",
   "module": "Techner",
   "name": "Job Applicant-custom_preview",
   "no_copy": 0,
   "non_negative": 0,
   "options": "<div id=\"resume-preview-container\" style=\"margin-top:15px;\">\n  <h4>Resume Preview</h4>\n  <div id=\"resume-preview\" style=\"border:1px solid #ddd; padding:10px; border-radius:6px;\">\n    Loading resume preview...\n  </div>\n</div>\n\n&lt;script&gt;\n(function() {\n\n    const resumeFieldName = \"resume_attachment\";   // your File field\n\n    function getResumeUrl() {\n        const field = document.querySelector(`[name=\"${resumeFieldName}\"]`);\n        if (!field || !field.value) return null;\n\n        let url = field.value.trim();\n\n        // If it's a private file, make sure it loads properly\n        if (url.startsWith(\"/private\")) {\n            url = window.location.origin + url;\n        }\n\n        return url;\n    }\n\n    function renderPreview(url) {\n        const previewDiv = document.getElementById(\"resume-preview\");\n\n        if (!url) {\n            previewDiv.innerHTML = \"<em>No resume uploaded yet.</em>\";\n            return;\n        }\n\n        const extension = url.split('.').pop().toLowerCase();\n\n        // PDF Preview\n        if (extension === \"pdf\") {\n            previewDiv.innerHTML = `\n                &lt;iframe src=\"${url}\" width=\"100%\" height=\"500px\" style=\"border:none;\"&gt;&lt;/iframe&gt;\n            `;\n        }\n        // Image Preview\n        else if ([\"jpg\", \"jpeg\", \"png\", \"gif\", \"webp\"].includes(extension)) {\n            previewDiv.innerHTML = `\n                <img src=\"${url}\" style=\"max-width:100%; max-height:500px;\">\n            `;\n        }\n        // Other file types (doc, docx, etc.)\n        else {\n            previewDiv.innerHTML = `\n                <p>Preview not supported for this file type.</p>\n                <a href=\"${url}\" target=\"_blank\">Download Resume</a>\n            `;\n        }\n    }\n\n    function updatePreview() {\n        const resumeUrl = getResumeUrl();\n        renderPreview(resumeUrl);\n    }\n\n    // Run when page loads\n    document.addEventListener(\"DOMContentLoaded\", updatePreview);\n\n    // Keep checking in case file is uploaded dynamically\n    setInterval(updatePreview, 1000);\n\n})();\n&lt;/script&gt;\n",
