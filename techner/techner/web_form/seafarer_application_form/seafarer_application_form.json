 "client_script": "frappe.web_form.after_load = function () {\n    const jobName = localStorage.getItem(\"selected_application_opening\");\n\n    if (!jobName) return;\n\n    let tries = 0;\n\n    const timer = setInterval(() => {\n        tries++;\n\n        // optional debug field\n        if (frappe.web_form.fields_dict.data_gsxu) {\n            frappe.web_form.set_value(\"data_gsxu\", jobName);\n        }\n\n        if (\n            frappe.web_form.fields_dict &&\n            frappe.web_form.fields_dict.application_opening\n        ) {\n            frappe.web_form.set_value(\"application_opening\", jobName);\n\n            // force visible input text too\n            const field =\n                frappe.web_form.fields_dict.application_opening;\n\n            if (field.$input) {\n                field.$input.val(jobName).trigger(\"change\");\n            }\n        }\n\n        if (tries > 20) {\n            localStorage.removeItem(\"selected_application_opening\");\n            clearInterval(timer);\n        }\n    }, 400);\n};\n\nfrappe.web_form.validate = function () {\n    const jobName =\n        frappe.web_form.get_value(\"application_opening\") ||\n        frappe.web_form.get_value(\"data_gsxu\") ||\n        localStorage.getItem(\"selected_application_opening\");\n\n    if (\n        jobName &&\n        frappe.web_form.fields_dict.application_opening\n    ) {\n        frappe.web_form.set_value(\"application_opening\", jobName);\n    }\n\n    return true;\n};",
